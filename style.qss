QWidget {
    color: #000000;
}

QMainWindow,
QDialog,
QWidget#content {
    background-color: #f4f7fb;
    color: #000000;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 10pt;
}

QLabel#pageTitle {
    color: #000000;
    font-size: 23pt;
    font-weight: 700;
}

QLabel#pageSubtitle {
    color: #000000;
    font-size: 10.5pt;
}

QWidget#bonusCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 18px;
}

QLabel#fieldLabel {
    color: #000000;
    font-weight: 600;
}

QLabel#fieldHint {
    color: #000000;
}

QLineEdit#bonusInput {
    background-color: #ffffff;
    border: 1px solid #000000;
    border-radius: 7px;
    color: #000000;
    padding: 9px 11px;
    selection-background-color: #2563eb;
    selection-color: #000000;
}

QLineEdit#bonusInput:focus {
    border: 1px solid #2563eb;
}

QPushButton {
    border: none;
    border-radius: 7px;
    padding: 10px 16px;
    font-weight: 600;
}

QPushButton#primaryButton {
    background-color: #2563eb;
    color: #000000;
}

QPushButton#primaryButton:hover {
    background-color: #1d4ed8;
}

QPushButton#secondaryButton {
    background-color: #e8efff;
    color: #000000;
}

QPushButton#secondaryButton:hover {
    background-color: #dbe7ff;
}

QPushButton#textButton {
    background-color: transparent;
    color: #000000;
}

QPushButton#textButton:hover {
    background-color: #e8edf5;
}

QTableWidget#gradesTable {
    background-color: #ffffff;
    alternate-background-color: #f8fafc;
    color: #000000;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    gridline-color: #edf2f7;
    selection-background-color: #dbeafe;
    selection-color: #000000;
}

QTableWidget#gradesTable::item {
    color: #000000;
    padding: 8px 10px;
    border: none;
}

QHeaderView::section {
    background-color: #eef2ff;
    color: #000000;
    border: none;
    border-bottom: 1px solid #dbe3f0;
    padding: 11px 10px;
    font-weight: 600;
}

QLabel#dialogTitle {
    color: #000000;
    font-size: 16pt;
    font-weight: 700;
}

QLabel#aboutDetails {
    color: #000000;
    line-height: 1.5;
}

QLabel#repositoryLink {
    color: #000000;
}

QLabel#repositoryLink a {
    color: #000000;
}

QLabel#repositoryLink a:visited,
QLabel#repositoryLink a:hover,
QLabel#repositoryLink a:pressed {
    color: #000000;
}

QToolTip {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid #000000;
    padding: 6px 8px;
}
